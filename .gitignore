# =============================================================================
# LabCompiler - Portable OpenGL Development Environment
# .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# 1. PORTABLE TOOL DISTRIBUTIONS (downloaded, not built from source)
#    These are large binary distributions that should NOT be version-controlled.
#    Document their versions and download URLs instead.
# ---------------------------------------------------------------------------
/MinGW/
/Cmake/
/Editor/
/Boost/

# ---------------------------------------------------------------------------
# 2. DISTRIBUTION ARCHIVES
# ---------------------------------------------------------------------------
LabCompiler*.zip

# ---------------------------------------------------------------------------
# 3. SCRIPT-GENERATED FILES
# ---------------------------------------------------------------------------
/path_backup.txt

# ---------------------------------------------------------------------------
# 4. BUILD ARTIFACTS (CMake / MinGW / generic)
# ---------------------------------------------------------------------------
# Build directories
build/
**/build/
mak.mingw.x64/
**/mak.mingw.x64/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CPackConfig.cmake
CPackSourceConfig.cmake

# Compiled binaries
*.exe
*.out
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib

# Executables in the GLFW bin output folder (keep .bat scripts)
/glfw-master/bin/*
!/glfw-master/bin/*.bat

# ---------------------------------------------------------------------------
# 5. OLD GLAD GENERATED SOURCE FILES
#    These are generated by the legacy glad online generator.
#    With glad2 they are replaced by a different workflow.
# ---------------------------------------------------------------------------
/glfw-master/OwnProjects/**/glad.c

# ---------------------------------------------------------------------------
# 6. IDE / EDITOR DROPPINGS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# 7. OS-SPECIFIC FILES
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 8. GLFW-SPECIFIC GENERATED FILES
# ---------------------------------------------------------------------------
/glfw-master/src/glfw3Config.cmake
/glfw-master/src/glfw3ConfigVersion.cmake
/glfw-master/src/glfw3.pc
/glfw-master/docs/html/

# ---------------------------------------------------------------------------
# 9. LOCAL TOOL OUTPUT
# ---------------------------------------------------------------------------
/_snapshots/
/.claude/
__pycache__/
*.zip

# ---------------------------------------------------------------------------
# 10. THIRD-PARTY CODE THAT IS NEVER EDITED (upstream GLFW and its bundled libs)
#     Only YOUR code is tracked: my_lib/, glfw-master/OwnProjects/, the root
#     scripts, glfw-master/CMakeLists.txt and the _GENERATE/_RE_COMPILE .bat files.
#     On a fresh clone, restore glfw-master/{src,include,deps,...} from the
#     GLFW release you started from (see _UPDATE_COMPONENTS.bat / the guide).
# ---------------------------------------------------------------------------
/glfw-master/src/
/glfw-master/include/
/glfw-master/CMake/
/glfw-master/docs/
/glfw-master/examples/
/glfw-master/tests/

# glfw-master/deps: ignore everything (SOIL2, glm, nuklear, stb, tinycthread, ...) ...
/glfw-master/deps/*
# ... EXCEPT glad, whose gl.h carries YOUR once-guard patch (_patch_glad_header.py)
!/glfw-master/deps/glad/

# Third-party sample project with bundled FreeImage libraries (28 MB)
/glfw-master/OwnProjects/hw0-glfw/
